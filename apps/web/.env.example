# Local settings for `pnpm dev` (copy to .env.local) — a deployed storefront
# reads these from the environment's Orun secrets instead (component.yaml).
#
# The store: your SLAS client and site. Salesforce's public demo instance
# (the PWA Kit demo backend) works with these values and no secret:
#   SFCC_CLIENT_ID=c9c45bfd-0ed3-4aa2-9971-40f88962b836
#   SFCC_ORGANIZATIONID=f_ecom_zzrf_001
#   SFCC_SHORTCODE=8o7m175y
#   SFCC_SITEID=RefArchGlobal
# Left empty, the storefront renders and says how to connect a store.
SFCC_CLIENT_ID=""
SFCC_ORGANIZATIONID=""
SFCC_SHORTCODE=""
SFCC_SITEID=""
# A private SLAS client's secret; empty for a public client (PKCE guest login).
SFCC_SECRET=""
# The `?secret=` app/api/revalidate requires; empty turns revalidation off.
SFCC_REVALIDATION_SECRET=""
# The footer's copyright holder (defaults to the site's name).
COMPANY_NAME=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
